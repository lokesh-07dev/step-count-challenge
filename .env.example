# ==============================================================================
# Stepora — Step Count Challenge Environment Configuration Template
# ==============================================================================
# Copy this file to .env in each corresponding app/worker or root directory
# DO NOT COMMIT PRIVATE KEYS OR PRODUCTION CREDENTIALS TO SOURCE CONTROL

# ------------------------------------------------------------------------------
# 1. Database (Neon PostgreSQL with connection pooling)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/stepora?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Minimum 32-character random string (e.g. generated via `openssl rand -base64 32`)
BETTER_AUTH_SECRET="generate_a_minimum_32_character_random_secret_here"
BETTER_AUTH_URL="http://localhost:8787"

# ------------------------------------------------------------------------------
# 3. Backend API Service (Cloudflare Worker / Hono)
# ------------------------------------------------------------------------------
PORT=8787
ENVIRONMENT="development"
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,exp://localhost:8081"

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 Storage (Media / Avatars)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="stepora-media"
R2_PUBLIC_URL="https://media.stepora.app"

# ------------------------------------------------------------------------------
# 5. Web Application (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:8787"
VITE_APP_NAME="Stepora"

# ------------------------------------------------------------------------------
# 6. Mobile Application (Expo + React Native)
# ------------------------------------------------------------------------------
# Android Emulator uses 10.0.2.2 to access host machine localhost; iOS Simulator uses localhost
EXPO_PUBLIC_API_URL="http://10.0.2.2:8787"
EXPO_PUBLIC_APP_NAME="Stepora"

