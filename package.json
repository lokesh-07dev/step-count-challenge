{
  "name": "stepora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Stepora — Production-grade Cross-Platform Step Count Challenge Platform",
  "workspaces": [
    "frontend/*",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace=@stepora/mobile run start",
    "dev:web": "npm --workspace=@stepora/web run dev",
    "dev:backend": "npm --workspace=@stepora/backend run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@rollup/wasm-node": "^4.68.8",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
